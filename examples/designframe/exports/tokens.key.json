{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "designframe key-mode overlay — emitted from PRISM.md (prism parse). Key brand color as canvas — saturated section bg with component key↔invert swap",
  "$mode": "key",
  "$df-native-mode": "key",
  "$extends": "tokens.json",
  "$merge-strategy": "deep-merge-overwrite",
  "color": {
    "theme": {
      "default": {
        "bg": {
          "$ref": "{color.theme.key.bg}"
        },
        "fg": {
          "$ref": "{color.theme.key.fg}"
        }
      }
    }
  }
}
